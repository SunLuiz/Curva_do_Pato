# ==============================================================================
# COCKPIT-OMNI — NASA Space Apps Challenge 2026
# Copy this file to .env (`cp .env.example .env`) for optional live backend ingestion.
# NOTE: The frontend + open natural-language assistant (`askEngine.js`) + 3D Rover Game
# run 100% WITHOUT any API keys using open CORS NASA endpoints and frozen snapshots.
# NEVER commit real secrets to version control.
# ==============================================================================

# --- 1. NASA Open APIs & Earth Observation (Optional Live Backend Refresh) ---
# NASA Open API Key (for live DONKI space weather ingestion in backend/app/clients/nasa_open_client.py)
# Free instant signup: https://api.nasa.gov/ (falls back to data/cache/donki_7d.json when unset)
NASA_API_KEY=

# NASA FIRMS Map Key (for live 24h MODIS/VIIRS fire CSV pulls in backend/app/clients/firms_client.py)
# Free signup: https://firms.modaps.eosdis.nasa.gov/api/map_key/ (falls back to data/firms_br_24h.csv & data/cache/fires_br_1d.geojson)
FIRMS_MAP_KEY=

# NASA POWER Base URL (100% open, zero key required — used by backend/app/clients/power_client.py)
NASA_POWER_BASE=https://power.larc.nasa.gov/api

# --- 2. Optional Server-Side LLM Proxy Keys (backend/app/main.py & frontend/api/ask.js) ---
# NOT required by the frontend: AskPanel uses the open client-side askEngine.js by default.
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
