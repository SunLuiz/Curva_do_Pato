# ==============================================
# COCKPIT-OMNI — NASA Space Apps 2026
# Copie este arquivo para .env e preencha.
# NUNCA commitar segredos reais.
# ==============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- NASA ---
# api.nasa.gov key (DONKI / clima espacial) — gratuita
NASA_API_KEY=
NASA_DONKI_BASE=https://api.nasa.gov/DONKI

# NASA POWER (aberto, sem chave — usado como fallback)
NASA_POWER_BASE=https://power.larc.nasa.gov/api

# EARTHDATA (só p/ NetCDF bruto GES DISC — opcional p/ hackathon)
NASA_EARTHDATA_BEARER_TOKEN=

# FIRMS (queimadas MODIS/VIIRS) — MAP_KEY gratuita
FIRMS_MAP_KEY=
FIRMS_BASE=https://firms.modaps.eosdis.nasa.gov

# Windy Webcams (anemometria visual) — WINDY_API_KEY gratuita
WINDY_API_KEY=
WINDY_BASE=https://api.windy.com

# --- Dados BR (reuso do ecossistema Cockpit-SIN) ---
ONS_CKAN_BASE_URL=https://dados.ons.org.br
ONS_API_TOKEN=
ONS_API_CARGA_BASE_URL=https://apicarga.ons.org.br/prd
NSRDB_BASE_URL=https://developer.nrel.gov/api/nsrdb/v2
NSRDB_API_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- LLM (copiloto explicável PT-BR) ---
GROQ_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
GONKA_BASE_URL=
GONKA_API_KEY=
