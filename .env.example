# ==============================================================================
# COCKPIT-OMNI — NASA Space Apps Challenge 2026
# Copy this file to .env (`cp .env.example .env`) for optional live backend ingestion.
# NOTE: The frontend + open natural-language assistant (`askEngine.js`) + 3D Rover Game
# run 100% WITHOUT any API keys using open CORS NASA endpoints and frozen snapshots.
# NEVER commit real secrets to version control.
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- 1. NASA Open APIs & Earth Observation (Cockpit Ecosystem) ---
# NASA Open API Key & Base (for live DONKI space weather ingestion in backend/app/clients/nasa_open_client.py)
# Free instant signup: https://api.nasa.gov/ (falls back to data/cache/donki_7d.json when unset)
NASA_API_KEY=
NASA_DONKI_BASE=https://api.nasa.gov/DONKI

# NASA POWER Base URL (100% open, zero key required — used by backend/app/clients/power_client.py
# and directly in-browser via CORS by frontend/src/engine/powerCors.js)
NASA_POWER_BASE=https://power.larc.nasa.gov/api

# NASA Earthdata Bearer Token (optional — used by scripts/freeze_cache.py when present;
# CMR collection discovery at https://cmr.earthdata.nasa.gov/search/collections.json works without a key)
NASA_EARTHDATA_BEARER_TOKEN=

# NASA FIRMS Map Key & Base (for live 24h MODIS/VIIRS fire CSV pulls in backend/app/clients/firms_client.py)
# Free signup: https://firms.modaps.eosdis.nasa.gov/api/map_key/ (falls back to data/firms_br_24h.csv & data/cache/fires_br_1d.geojson)
FIRMS_MAP_KEY=
FIRMS_BASE=https://firms.modaps.eosdis.nasa.gov

# Brazilian National Grid Open Catalog (ONS CKAN — backend/app/clients/ons_client.py, zero key required)
ONS_CKAN_BASE_URL=https://dados.ons.org.br

# --- 2. Optional Server-Side LLM Proxy Keys (backend/app/main.py & frontend/api/ask.js) ---
# NOT required by the frontend: AskPanel uses the open client-side askEngine.js by default.
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- 3. Worldwide Hall of Fame Persistence (Vercel frontend/api/ranking.js) ---
# Set ONLY inside Vercel Project Settings -> Environment Variables (never ship private keys in browser JS!).
# Local clones automatically sync via open CORS to https://www.curveofduck.xyz/api/ranking (or fallback to localStorage).
# Option A (GitHub Gist - simplest zero-deploy-loop setup):
GITHUB_RANKING_TOKEN=
GITHUB_RANKING_GIST_ID=
GITHUB_RANKING_GIST_FILE=curve_of_duck_ranking.json
# Option B (Dedicated GitHub Repo Branch - omit GIST_ID above; never targets main by default):
GITHUB_RANKING_REPO=SunLuiz/Curva_do_Pato
GITHUB_RANKING_BRANCH=leaderboard-data
GITHUB_RANKING_PATH=hall_of_fame.json
# Option C (Upstash / Vercel Redis REST):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional Frontend Build Override (defaults to /api/ranking on Vercel or https://www.curveofduck.xyz/api/ranking locally):
VITE_RANKING_API_URL=
