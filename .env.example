# ==============================================================================
# COCKPIT-OMNI — NASA Space Apps Challenge 2026
# Copy this file to .env (`cp .env.example .env`) for optional live backend ingestion.
# NOTE: The frontend + open natural-language assistant (`askEngine.js`) + 3D Rover Game
# run 100% WITHOUT any API keys using open CORS NASA endpoints and frozen snapshots.
# NEVER commit real secrets to version control.
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- 1. NASA Open APIs & Earth Observation ---
# NASA Open API Key (for live DONKI space weather ingestion in backend/app/clients/nasa_open_client.py)
# Free instant signup: https://api.nasa.gov/ (falls back to "DEMO_KEY" or data/cache/donki_7d.json)
NASA_API_KEY=
NASA_DONKI_BASE=https://api.nasa.gov/DONKI

# NASA POWER (100% open, zero key required — used both by backend/app/clients/power_client.py
# and directly in-browser via CORS by frontend/src/engine/askEngine.js)
NASA_POWER_BASE=https://power.larc.nasa.gov/api

# NASA Earthdata Bearer Token (optional — only needed for raw GES DISC NetCDF/SAR granule downloads;
# CMR collection discovery at https://cmr.earthdata.nasa.gov/search/collections.json requires no key)
# Register at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_BEARER_TOKEN=

# NASA FIRMS Map Key (for live 24h MODIS/VIIRS fire CSV pulls in backend/app/clients/firms_client.py)
# Free signup: https://firms.modaps.eosdis.nasa.gov/api/map_key/ (falls back to data/cache/fires_br_1d.geojson)
FIRMS_MAP_KEY=
FIRMS_BASE=https://firms.modaps.eosdis.nasa.gov

# --- 2. Optional Meteorological & Grid Telemetry Extensions ---
# Windy Webcams API (optional visual anemometry reference) — https://api.windy.com/
WINDY_API_KEY=
WINDY_BASE=https://api.windy.com

# Brazilian National Grid Operator (ONS CKAN open catalog — backend/app/clients/ons_client.py)
ONS_CKAN_BASE_URL=https://dados.ons.org.br
ONS_API_TOKEN=
ONS_API_CARGA_BASE_URL=https://apicarga.ons.org.br/prd

# NREL NSRDB & Copernicus CDS (optional external solar/reanalysis cross-checks)
NSRDB_BASE_URL=https://developer.nrel.gov/api/nsrdb/v2
NSRDB_API_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- 3. Optional Server-Side LLM Proxy Keys (backend/app/main.py & frontend/api/ask.js) ---
# NOT required by the frontend: AskPanel uses the open client-side askEngine.js by default.
GROQ_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
GONKA_BASE_URL=
GONKA_API_KEY=
